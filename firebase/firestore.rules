rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    match /usernames/{username} {
      allow read: if true;
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && username.matches('^[a-z0-9_-]{3,20}$');
      allow update, delete: if false;
    }

    match /profiles/{uid} {
      allow read: if true;
      allow create: if isSelf(uid)
                    && request.resource.data.uid == uid
                    && request.resource.data.username_lower.matches('^[a-z0-9_-]{3,20}$')
                    && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username_lower)).data.uid == uid;
      allow update: if isSelf(uid)
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.username == resource.data.username
                    && request.resource.data.username_lower == resource.data.username_lower;
      allow delete: if false;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn()
                    && request.resource.data.author_uid == request.auth.uid
                    && request.resource.data.content is string
                    && request.resource.data.content.size() > 0
                    && request.resource.data.content.size() <= 280;
      allow update: if signedIn()
                    && resource.data.author_uid == request.auth.uid
                    && request.resource.data.author_uid == resource.data.author_uid
                    && request.resource.data.created_at == resource.data.created_at
                    && request.resource.data.content is string
                    && request.resource.data.content.size() > 0
                    && request.resource.data.content.size() <= 280
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'edited_at']);
      allow delete: if signedIn() && resource.data.author_uid == request.auth.uid;
    }


    match /comments/{commentId} {
      allow read: if true;
      allow create: if signedIn()
                    && request.resource.data.author_uid == request.auth.uid
                    && request.resource.data.post_id is string
                    && exists(/databases/$(database)/documents/posts/$(request.resource.data.post_id))
                    && request.resource.data.content is string
                    && request.resource.data.content.size() > 0
                    && request.resource.data.content.size() <= 280;
      allow update: if false;
      allow delete: if signedIn() && resource.data.author_uid == request.auth.uid;
    }


    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.target_uid == request.auth.uid;

      allow create: if signedIn()
                    && request.resource.data.actor_uid == request.auth.uid
                    && request.resource.data.target_uid != request.auth.uid
                    && request.resource.data.read == false
                    && (
                      (
                        request.resource.data.type == 'like'
                        && request.resource.data.post_id is string
                        && notificationId == 'like_' + request.auth.uid + '_' + request.resource.data.post_id
                        && get(/databases/$(database)/documents/posts/$(request.resource.data.post_id)).data.author_uid == request.resource.data.target_uid
                        && getAfter(/databases/$(database)/documents/likes/$(request.auth.uid + '_' + request.resource.data.post_id)).data.user_uid == request.auth.uid
                      )
                      ||
                      (
                        request.resource.data.type == 'comment'
                        && request.resource.data.post_id is string
                        && request.resource.data.comment_id is string
                        && notificationId == 'comment_' + request.resource.data.comment_id
                        && get(/databases/$(database)/documents/posts/$(request.resource.data.post_id)).data.author_uid == request.resource.data.target_uid
                        && getAfter(/databases/$(database)/documents/comments/$(request.resource.data.comment_id)).data.author_uid == request.auth.uid
                      )
                      ||
                      (
                        request.resource.data.type == 'follow'
                        && notificationId == 'follow_' + request.auth.uid + '_' + request.resource.data.target_uid
                        && getAfter(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + request.resource.data.target_uid)).data.follower_uid == request.auth.uid
                      )
                      ||
                      (
                        request.resource.data.type == 'message'
                        && request.resource.data.conversation_id is string
                        && request.resource.data.message_id is string
                        && request.resource.data.message_preview is string
                        && request.resource.data.message_preview.size() <= 120
                        && notificationId == 'message_' + request.resource.data.message_id
                        && getAfter(/databases/$(database)/documents/conversations/$(request.resource.data.conversation_id)/messages/$(request.resource.data.message_id)).data.sender_uid == request.auth.uid
                        && getAfter(/databases/$(database)/documents/conversations/$(request.resource.data.conversation_id)/messages/$(request.resource.data.message_id)).data.receiver_uid == request.resource.data.target_uid
                      )
                    );

      allow update: if signedIn()
                    && resource.data.target_uid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
                    && request.resource.data.read == true;

      allow delete: if signedIn()
                    && (
                      resource.data.target_uid == request.auth.uid
                      || resource.data.actor_uid == request.auth.uid
                    );
    }

    match /conversations/{conversationId} {
      allow read: if signedIn()
                  && request.auth.uid in resource.data.member_uids;

      allow create: if signedIn()
                    && request.resource.data.member_uids is list
                    && request.resource.data.member_uids.size() == 2
                    && request.resource.data.member_uids[0] != request.resource.data.member_uids[1]
                    && request.auth.uid in request.resource.data.member_uids
                    && conversationId == request.resource.data.member_uids[0] + '__' + request.resource.data.member_uids[1]
                    && exists(/databases/$(database)/documents/profiles/$(request.resource.data.member_uids[0]))
                    && exists(/databases/$(database)/documents/profiles/$(request.resource.data.member_uids[1]))
                    && request.resource.data.last_sender_uid == request.auth.uid
                    && request.resource.data.last_message is string
                    && request.resource.data.last_message.size() <= 160;

      allow update: if signedIn()
                    && request.auth.uid in resource.data.member_uids
                    && request.resource.data.member_uids == resource.data.member_uids
                    && request.resource.data.created_at == resource.data.created_at
                    && request.resource.data.last_sender_uid == request.auth.uid
                    && request.resource.data.last_message is string
                    && request.resource.data.last_message.size() <= 160
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updated_at', 'last_message', 'last_sender_uid', 'last_message_id']);

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
                    && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.member_uids;

        allow create: if signedIn()
                      && request.resource.data.sender_uid == request.auth.uid
                      && request.resource.data.receiver_uid != request.auth.uid
                      && request.auth.uid in getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.member_uids
                      && request.resource.data.receiver_uid in getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.member_uids
                      && request.resource.data.content is string
                      && request.resource.data.content.size() > 0
                      && request.resource.data.content.size() <= 1000;

        allow update: if false;
        allow delete: if signedIn() && resource.data.sender_uid == request.auth.uid;
      }
    }

    match /conversation_reads/{readId} {
      allow read: if signedIn() && resource.data.user_uid == request.auth.uid;
      allow create, update: if signedIn()
                            && request.resource.data.user_uid == request.auth.uid
                            && readId == request.resource.data.conversation_id + '__' + request.auth.uid
                            && request.auth.uid in getAfter(/databases/$(database)/documents/conversations/$(request.resource.data.conversation_id)).data.member_uids;
      allow delete: if signedIn() && resource.data.user_uid == request.auth.uid;
    }

    match /likes/{likeId} {
      allow read: if true;
      allow create: if signedIn()
                    && request.resource.data.user_uid == request.auth.uid
                    && likeId == request.auth.uid + '_' + request.resource.data.post_id;
      allow update: if false;
      allow delete: if signedIn() && resource.data.user_uid == request.auth.uid;
    }

    match /follows/{followId} {
      allow read: if true;
      allow create: if signedIn()
                    && request.resource.data.follower_uid == request.auth.uid
                    && request.resource.data.following_uid != request.auth.uid
                    && followId == request.auth.uid + '_' + request.resource.data.following_uid;
      allow update: if false;
      allow delete: if signedIn() && resource.data.follower_uid == request.auth.uid;
    }
  }
}
